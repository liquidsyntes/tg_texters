# Set these in the bot process environment. Do not send secrets in Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DISENSE_DATA_DIR=./data

# Choose one translation route in the bot with /provider and /model.
OPENROUTER_API_KEY=
OPENCODE_BIN=opencode
OPENCODE_VERSION=v2

# Fill in when the hosting destination is known.
PUBLIC_BASE_URL=
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_KEY_PATH=
SFTP_HOST_KEY=
SFTP_REMOTE_DIR=

# For local development only. Use an absolute directory, and leave SFTP_HOST empty.
PUBLISH_TARGET=
